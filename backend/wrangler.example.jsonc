{
  "name": "g-super-league-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://junjieyu28.github.io,http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "g-super-league",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "g-super-league-photos"
    }
  ]
}