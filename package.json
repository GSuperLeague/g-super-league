{
  "name": "g-super-league",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:snapshot": "node --experimental-strip-types scripts/dev-snapshot.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node tests/singles.e2e.mjs",
    "test:e2e:rank": "node --experimental-strip-types tests/rankings.e2e.mjs",
    "test:e2e:seasons": "node --experimental-strip-types tests/seasons.e2e.mjs",
    "api:dev": "wrangler dev --config backend/wrangler.jsonc",
    "api:deploy": "node scripts/check-db-config.mjs && wrangler deploy --config backend/wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config backend/wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config backend/wrangler.jsonc",
    "db:singles:local": "wrangler d1 migrations apply DB_SINGLES --local --config backend/wrangler.jsonc",
    "db:singles:remote": "wrangler d1 migrations apply DB_SINGLES --remote --config backend/wrangler.jsonc",
    "backup": "node scripts/migrate.mjs export",
    "restore": "node scripts/migrate.mjs import"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.27.3",
    "miniflare": "4.20260515.0",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
